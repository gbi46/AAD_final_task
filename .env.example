# Шаблон конфігурації. Скопіювати у .env і заповнити реальними значеннями локально.
# .env у Git не потрапляє (див. .gitignore).

# LLM-провайдер: модель задається змінною, а не хардкодиться в коді.
# За замовчуванням — Gemini (безкоштовний tier). gemini-flash-latest —
# псевдонім на актуальну рекомендовану flash-модель: конкретні версійні
# імена (gemini-2.5-flash тощо) з часом деприкейтяться для нових ключів
# (перевірено емпірично, S10) — псевдонім цього уникає. Якщо потрібна
# саме конкретна версія — підставити її сюди (напр. gemini-3.6-flash).
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-flash-latest
GOOGLE_API_KEY=

# Альтернативні провайдери (розкоментувати за потреби, LLM_PROVIDER відповідно змінити)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=mistral
# MISTRAL_API_KEY=

# Observability — знадобиться з експертного рівня (Завд. 5)
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=aad-final-mas
