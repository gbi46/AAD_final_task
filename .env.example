# Шаблон конфігурації. Скопіювати у .env і заповнити реальними значеннями локально.
# .env у Git не потрапляє (див. .gitignore).

# LLM-провайдер: модель задається змінною, а не хардкодиться в коді.
# За замовчуванням — Gemini 2.5 Flash (стабільна GA-версія, безкоштовний tier).
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=

# Альтернативні провайдери (розкоментувати за потреби, LLM_PROVIDER відповідно змінити)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=mistral
# MISTRAL_API_KEY=

# Observability — знадобиться з експертного рівня (Завд. 5)
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=aad-final-mas
