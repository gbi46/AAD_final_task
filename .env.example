# Шаблон конфігурації. Скопіювати у .env і заповнити реальними значеннями локально.
# .env у Git не потрапляє (див. .gitignore).

# LLM-провайдер: модель задається змінною, а не хардкодиться в коді. Яка
# саме гілка коду використовується, визначається явним параметром
# provider="demo"|"gemini"|"openrouter" при створенні MASApp(...) у
# конкретному скрипті (mas_langgraph.py __main__, persistence_demo.py,
# hitl.py) — значення нижче лише постачають модель/ключ для обраної гілки.

# Варіант 1 — Gemini напряму (потрібен GOOGLE_API_KEY, безкоштовний tier
# з денним лімітом запитів на модель). gemini-flash-latest — псевдонім на
# актуальну рекомендовану flash-модель: конкретні версійні імена
# (gemini-2.5-flash тощо) з часом деприкейтяться для нових ключів
# (перевірено емпірично, S10) — псевдонім цього уникає.
GEMINI_MODEL=gemini-flash-latest
GOOGLE_API_KEY=

# Варіант 2 — OpenRouter: один OpenAI-сумісний ендпоінт до тієї самої
# рекомендованої в завданні моделі (тут — Claude Sonnet, одна з опцій
# task.txt), лише інший спосіб доступу; корисно, коли пряма квота
# вичерпана чи прямого ключа немає. Слаг моделі — з каталогу openrouter.ai.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_API_KEY=

# Альтернативні прямі провайдери (розкоментувати за потреби; наразі не
# підключені в mas_langgraph.py — додати за тим самим патерном, що й gemini)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=

# Observability — знадобиться з експертного рівня (Завд. 5)
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=aad-final-mas
